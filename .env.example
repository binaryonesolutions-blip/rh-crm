# ============================================================
# Rhombus Concrete Quotation App — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# App URL — used to build shareable quote links
# Development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (update after deploying to Vercel):
# NEXT_PUBLIC_APP_URL=https://quotes.rhombusconcrete.co.ke
